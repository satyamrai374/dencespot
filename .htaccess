# DenceSpot — clean URLs and canonical redirects
# Apache / LiteSpeed (Hostinger). Every internal link in includes/config.php is
# already extensionless (/hair-transplant-in-gurgaon, /blog/, /contact), so
# without this file the whole PHP build 404s.
#
# Order matters below: all 301s run first so the browser lands on the canonical
# URL, then one internal rewrite maps it to the .php file. Nothing here rewrites
# a URL that is already canonical, so there are no redirect loops.

Options -MultiViews -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# RewriteBase /        # uncomment only if the site is served from a subdirectory


# ─────────────────────────────────────────────────────────────────────────────
# 1. Canonical host + HTTPS
#    Resolved: HTTPS is forced by the host, and non-www is canonical.
# ─────────────────────────────────────────────────────────────────────────────
# HTTPS is already forced by Hostinger at the server level (http:// returns a
# clean 301), so the redirect below stays off — enabling it would add a second
# competing redirect. Uncomment only if that ever stops being true.
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www -> non-www. Non-www is the canonical form: it is what SITE_ORIGIN,
# every <link rel=canonical> and every sitemap <loc> already use. Before this
# rule the full site answered on both hostnames with HTTP 200, which splits
# link equity and leaves a canonical tag (a hint) doing a 301's job.
RewriteCond %{HTTP_HOST} ^www\.dencespot\.com$ [NC]
RewriteRule ^ https://dencespot.com%{REQUEST_URI} [R=301,L]


# ─────────────────────────────────────────────────────────────────────────────
# 1b. Comparison URLs → the articles that already cover them
#
#     These five root URLs were requested as part of the site's URL plan, and
#     each already has a near-identical article under /blog/. Publishing a
#     second copy at the root would put two pages of ours in competition for
#     the same query — the cannibalisation SEO-STRATEGY-dencespot.md §5 flags
#     as the old site's central failure.
#
#     So the URL resolves and the reader lands on the real article. If any of
#     these is later wanted as a standalone commercial page, delete its line
#     here AND 301 the blog post to the new root URL — never run both.
# ─────────────────────────────────────────────────────────────────────────────
RewriteRule ^fue-vs-dhi-hair-transplant/?$          /blog/fue-vs-dhi-hair-transplant [R=301,L]
RewriteRule ^fue-vs-fut-hair-transplant/?$          /blog/fue-vs-fut-hair-transplant [R=301,L]
RewriteRule ^prp-vs-hair-transplant/?$              /blog/prp-or-hair-transplant [R=301,L]
RewriteRule ^prp-vs-gfc-treatment/?$                /blog/prp-vs-gfc-vs-exosomes [R=301,L]
RewriteRule ^hair-transplant-risks-and-side-effects/?$ /blog/hair-transplant-side-effects-and-risks [R=301,L]



# ─────────────────────────────────────────────────────────────────────────────
# 2. sitemap.php is served as /sitemap.xml
#    robots.txt advertises https://dencespot.com/sitemap.xml and sitemap.php
#    expects that mapping. Both /sitemap.php and /sitemap fold into the .xml URL
#    so the sitemap has exactly one address.
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{THE_REQUEST} \s/+sitemap(\.php)?[\s?] [NC]
RewriteRule ^ /sitemap.xml [R=301,L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]


# ─────────────────────────────────────────────────────────────────────────────
# 3. index.php → directory root
#    /index.php → /   and   /blog/index.php → /blog/
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]


# ─────────────────────────────────────────────────────────────────────────────
# 4. Strip the .php extension  →  /about-us.php redirects to /about-us
#
#    enquire.php is deliberately excluded. It is the lead-form POST target
#    (includes/components.php: action="/enquire.php"). A 301 on a POST is not
#    safely re-issued by every browser — some downgrade it to GET and drop the
#    body — which would silently break every enquiry. It stays served directly.
#    If the form action is ever changed to /enquire, delete the exclusion line.
#
#    THE_REQUEST is used rather than REQUEST_URI so this only fires on a real
#    client request, never on the internal rewrite in section 7 (which would
#    loop). Same reason section 2 can safely map /sitemap.xml onto sitemap.php.
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} !^/enquire\.php$ [NC]
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]


# ─────────────────────────────────────────────────────────────────────────────
# 5. Legacy .html design exports → the PHP page that replaced them
#    Only fires where a matching .php exists, so exports whose PHP page is not
#    built yet (FUE/DHI/FUT at time of writing) keep serving as-is.
#    Remove this block once the exports move into _design/.
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteCond %{DOCUMENT_ROOT}/%1.php -f
RewriteRule ^ /%1 [R=301,L]


# ─────────────────────────────────────────────────────────────────────────────
# 6. Drop the trailing slash on pages (real directories keep theirs, so /blog/
#    is untouched). Canonical form is no trailing slash, matching config.php.
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)/+[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]


# ─────────────────────────────────────────────────────────────────────────────
# 7. The actual rewrite: /about-us → about-us.php, /blog/slug → blog/slug.php
#    Runs only when the extensionless path is not itself a real file/directory
#    and the .php counterpart exists. Query strings carry over automatically.
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# 7b. Delhi hair transplant area pages (25 Oct 2026): a /hair-transplant-delhi/
#     <slug> with no .php file of its own is served by one template, which
#     answers 404 for a slug that is not in includes/delhi-areas-data.php.
#     No QSA: the slug always comes from the path, so a ?slug= in the address
#     cannot show one area's page at another's URL. Mirrored in router.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php !-f
RewriteRule ^hair-transplant-delhi/([a-z0-9-]+)$ hair-transplant-delhi/area.php?slug=$1 [L]


# ─────────────────────────────────────────────────────────────────────────────
# 8. Keep internals off the web
# ─────────────────────────────────────────────────────────────────────────────
# dencespot.com-audit/ holds the internal SEO audit: crawl dumps, screenshots
# and a full HTML report naming unconfirmed pricing and launch blockers. It is
# git-tracked, so it deploys; without this rule it was publicly readable.
RewriteRule ^(includes|storage|_design|_ds|dencespot\.com-audit|\.claude|\.git)(/|$) - [F,L]

# ─────────────────────────────────────────────────────────────────────────────
# 9. Unknown URLs are handled by 404.php at the requested address (14 Oct 2026)
# ─────────────────────────────────────────────────────────────────────────────
# This used to 302 every unknown URL to /404. That threw away the 337 old
# blog and locality URLs of the previous site, and a redirect to an error page
# reads as a soft 404. 404.php now 301s an old URL to its counterpart
# (includes/legacy-redirects.php) and otherwise shows the 404 page with a real
# 404 status. The .php clean-up rules above match THE_REQUEST, so this
# internal rewrite cannot loop.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/404$
RewriteCond %{REQUEST_URI} !^/404\.php$
RewriteRule ^ /404.php [L]

</IfModule>


# Working documents and build tooling are served as plain text by default —
# BUILD-PROGRESS.md and the strategy files contain internal notes, unconfirmed
# pricing and launch blockers. Never publicly readable.
<FilesMatch "\.(md|mjs|lock|log|bak|sql|sh|ini|dist|json|ndjson)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>




# ─────────────────────────────────────────────────────────────────────────────
# 9. Security headers
#    A medical site collecting patient enquiry details should not be shipping
#    a bare header set. None of these are ranking factors; all of them are
#    table stakes for a form that takes a name, a phone number and a symptom.
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # One year, subdomains included. Only safe because HTTPS is already forced.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # frame-ancestors rather than X-Frame-Options: the pages embed a Google Map
  # and the Elfsight reviews widget, so framing must be restricted, not banned.
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'"

  # Stop advertising the exact PHP build. expose_php=Off in php.ini is the
  # better fix where the host allows it; this covers the case where it does not.
  Header always unset X-Powered-By
</IfModule>


# ─────────────────────────────────────────────────────────────────────────────
# 10. Compression
#
# Text assets only. Images and fonts are already compressed formats — running
# them through DEFLATE costs CPU and saves nothing.
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>


# ─────────────────────────────────────────────────────────────────────────────
# 11. Browser caching
#
# The patient photographs are the heaviest thing on the site and never change
# once published, so they get a year. HTML is never cached: prices, hours and
# the review date have to be able to change the moment they are deployed.
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
  # sitemap.xml (generated by sitemap.php) and robots.txt / llms.txt must
  # change the moment pages do. Without these lines the host default of two
  # days applied, and the CDN kept serving a 13 Sep 2026 sitemap (65 URLs,
  # withdrawn pages in, every Rohini page and new article out) a month later.
  ExpiresByType application/xml         "access plus 0 seconds"
  ExpiresByType text/xml                "access plus 0 seconds"
  ExpiresByType text/plain              "access plus 1 hour"
  ExpiresDefault                        "access plus 2 days"
</IfModule>
